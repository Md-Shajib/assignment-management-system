# ==========================================
# Database Configuration
# ==========================================
POSTGRES_DB=your_database_name
POSTGRES_USER=your_postgres_username
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_PORT=your_postgres_port_number
DB_CONNECTION_STRING=Host=localhost;Port=your_postgres_port_number;Database=your_database_name;Username=your_postgres_username;Password=your_postgres_password

# ==========================================
# JWT Security Settings
# ==========================================
JWT_SECRET=your_super_secret_key_at_least_32_characters_long
JWT_ISSUER=AssignmentSystem
JWT_AUDIENCE=AssignmentSystemUsers
JWT_EXPIRATION_IN_MINUTES=120

# ==========================================
# Frontend Configuration (Next.js)
# ==========================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api
